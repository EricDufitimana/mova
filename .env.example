# OPTIONAL: enable the Google Maps JavaScript API tab.
# Enables Google maps automatically; enable Maps JavaScript, Routes, and Geocoding APIs.
# Without a key, ASYV/Ntunga uses OpenStreetMap and illustrative approach paths.
# Restrict browser keys by website referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Vercel backend only: connect a Postgres database in the Vercel dashboard.
# Use the provider's pooled URL with its required SSL settings.
# Never prefix this secret with VITE_ or put it in client code.
DATABASE_URL=
